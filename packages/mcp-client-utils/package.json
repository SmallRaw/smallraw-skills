{
  "name": "mcp-client-utils",
  "version": "0.2.0",
  "description": "Lazy MCP client CLI — connect, call, disconnect on demand via registry",
  "bin": {
    "mcp-client-utils": "dist/mcp-utils.js"
  },
  "files": [
    "dist/mcp-utils.js",
    "mcp-registry.schema.json"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/mcp-utils.js --banner:js='#!/usr/bin/env node' && node -e \"require('fs').chmodSync('dist/mcp-utils.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli"
  ],
  "license": "MIT"
}
